# =====================================================================
# MODELO DE EXEMPLO. NÃO coloque credenciais reais neste arquivo.
# Copie para ".env" (cp .env.exemplo .env) e preencha lá com os seus valores.
# O ".env" é ignorado pelo git e nunca deve ser publicado.
# =====================================================================

# Banco PostgreSQL (Supabase > Connect > Session pooler).
# Se a senha tiver caracteres especiais (@, !, #, /), codifique-a (URL-encode).
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Agente SQL: provedor de IA (anthropic ou openai) e modelo
LLM_PROVIDER=anthropic
LLM_MODEL=nome-do-modelo

# Chave do provedor escolhido acima (preencha só a que for usar)
ANTHROPIC_API_KEY=sua-chave-aqui
OPENAI_API_KEY=sua-chave-aqui
